# The image of one of the example's two oneshots, named by PROGRAM: provision-store or migrate-store,
# built statically and run from an empty image. Built with
# `podman build --build-arg PROGRAM=provision-store oneshots/go/store`.
FROM docker.io/library/golang:1.26 AS build
ARG PROGRAM
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -o /out/program "./${PROGRAM:?name the program to build}"

FROM scratch
COPY --from=build /out/program /program
ENTRYPOINT ["/program"]
